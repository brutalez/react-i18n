{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": [
      "react",
      "react-dom",
      "node",
      "vitest/globals",
      "@testing-library/jest-dom"
    ]
  },
  "include": ["src", "playwright.config.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
